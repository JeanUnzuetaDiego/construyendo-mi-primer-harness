# Configuración del harness. La leen los scripts (guardia, fase, doctor, instalar).
PRODUCTO_DIRS="back web"             # carpetas de código de producto: ahí solo se edita lo que el expediente declara
RAMAS_LARGAS="main master develop"   # ramas donde no se escribe código de producto
PRESUPUESTO_BYTES=3000               # tamaño máximo de la constitución: es lo que se carga SIEMPRE
CONSTITUCION="AGENTS.md"             # archivo de la constitución (AGENTS.md lo leen Cursor y, vía CLAUDE.md, Claude Code)
